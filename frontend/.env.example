# Supabase
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-id>

# Site
VITE_SITE_URL=https://<your-domain.com>

# URL HTTPS da versão web do app do aluno (opcional; sem tokens ou parâmetros)
VITE_ALUNO_APP_URL=

# App Mobile (opcional)
VITE_PLAY_STORE_LINK=https://play.google.com/store/apps/details?id=...
VITE_APK_URL=https://...

# Pesquisa com professores: link de resposta do formulário de INSCRIÇÃO (Google Forms).
# O da avaliação não fica aqui (o bundle é público): mora em app_config.pesquisa_link_avaliacao
# e só sai, por pesquisa_meu_acesso(), para o avaliador aprovado, na aba Avaliar o TrailUp.
# Gerado por scripts/apps-script-formulario-professores. Vazio enquanto a inscrição não abre: a
# cartilha em /pesquisa/professores mostra "formulário ainda não aberto".
VITE_PESQUISA_INSCRICAO_FORM_URL=
# App da Web do mesmo Apps Script (doGet em Planilha.gs): a página de inscrição manda as respostas
# direto ao Forms e pergunta aqui se o código do envio chegou; responde só {"recebida": true|false}.
# Com ele e um formulário conhecido em src/features/pesquisa/inscricaoNoSite.ts, a inscrição é feita
# na própria página; sem ele, a página usa o Google Forms. Formato: https://script.google.com/macros/s/<id>/exec
VITE_PESQUISA_INSCRICAO_CONFIRMACAO_URL=
# Link de resposta do formulário de atualização da forma de divulgação (mesmo script).
VITE_PESQUISA_ATUALIZACAO_FORM_URL=

# API de personalização (TraiUp backend)
# Produção: https://api.trailup.promora.dev.br (Let's Encrypt). Na Vercel, o
# console chama primeiro o proxy `/trailup-api`, que já aponta para lá em
# `vercel.json`. Não use os hosts `*.traefik.me`: o certificado deles é
# autoassinado e o navegador recusa (#96).
VITE_APITRAIUP_URL=http://localhost:8000

# Client ID OAuth web do Google (público; nunca coloque o client_secret aqui)
VITE_GOOGLE_CLIENT_ID=<google-web-client-id>

# Supabase Edge Function — IA (NÃO expor no frontend)
# Obter chave em: https://aistudio.google.com/apikey (gratuito, sem cartão)
# Configurar via: supabase secrets set GEMINI_API_KEY=AIza...
# GEMINI_API_KEY=AIza...
