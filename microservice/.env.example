# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Aceita 1 ou varias chaves separadas por virgula/ponto-e-virgula
# (GEMINI_API_KEY=chave1,chave2,chave3) — cada chave tem sua propria cota
# diaria gratuita, e todo o servico de geracao (texto/audio/imagem) alterna
# automaticamente pra proxima chave disponivel quando uma esgota a cota.
# Com 1 chave so, esgotar a cota do dia abre o circuito de indisponibilidade
# do Gemini e forca TODA geracao a exigir a contingencia da OpenAI (mesmo
# apos a rotacao de 11 modelos em CONTENT_GENERATION_MODEL/GEMINI_TEXT_
# FALLBACK_MODELS) - se a conta OpenAI estiver sem credito, tudo falha.
# Gerar mais chaves gratuitas em https://aistudio.google.com/apikey (mesma
# conta Google ou contas diferentes) e listar aqui evita depender da OpenAI
# nesse cenario, sem custo.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=
# Geração personalizada: Gemini é o principal; OpenAI é contingência automática
# CONTENT_GENERATION_MODEL=gemini-3.6-flash
# Cota diaria do free tier e por (chave, modelo) — varios desses modelos tem
# teto bem maior (ou ilimitado) que gemini-3.6-flash. Cada um e tentado em
# todas as chaves antes de passar pro proximo, so quando TODAS as chaves
# esgotam a cota do modelo anterior.
# Ordem prioriza a serie 3.x: gemini-2.5-flash-lite (e outros modelos 2.x)
# retornaram 404 "no longer available to new users" em producao — contas
# novas parecem so ter acesso a serie 3.x. Dentro de cada geracao a ordem
# geralmente vai de -lite (cota mais generosa/barata) pra -flash, depois
# -pro (mais capaz; "mais simples" pro "mais restrito", nao necessariamente
# cota maior) — exceto o par gemini-2.0-flash/gemini-2.0-flash-lite, que ja
# estava na ordem inversa antes desta lista ser ampliada de 5 pra 11 modelos
# e nao foi reordenado aqui. gemini-1.5-* fica no fim como tentativa residual
# mais antiga, ainda mais incerta que a serie 2.x.
# GEMINI_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash,gemini-3.5-flash-lite,gemini-3.6-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-pro
# TTS e imagem sao familias de modelo diferentes de texto — nao usam a lista
# acima. gemini-2.5-flash-preview-tts / gemini-2.0-flash-preview-image-
# generation sao os mesmos modelos ja referenciados como GEMINI_MODEL_TTS /
# GEMINI_MODEL_IMAGE no lado da API — mas ainda nao confirmados contra o
# mesmo bloqueio de "no longer available to new users" que atingiu os
# modelos de texto 2.x; troque se tambem falharem.
# GEMINI_TTS_FALLBACK_MODELS=gemini-2.5-flash-preview-tts
# GEMINI_IMAGE_FALLBACK_MODELS=gemini-2.0-flash-preview-image-generation
# Quantas vezes repete com o PROPRIO Gemini (feedback corretivo) quando a
# saida falha na validacao de qualidade (ex.: cobertura insuficiente), antes
# de exigir a OpenAI como recuperacao obrigatoria. Sem isso, com a conta
# OpenAI sem credito, uma unica falha de qualidade do Gemini virava falha
# permanente da geracao inteira mesmo com o Gemini saudavel.
# CONTENT_GENERATION_GEMINI_QUALITY_MAX_ATTEMPTS=3
# Blocos por lote (cada bloco do lote vira seu proprio capitulo, nunca
# mesclados numa unica chamada — ver mergeContentBlocksIntoOne, mantida so
# para os testes). Default 6, teto 8. Nem 1 (martela a cota por bloco) nem
# o topico inteiro numa chamada so (o Gemini passou a resumir agressivamente
# quando viu 24 blocos concatenados de uma vez).
# CONTENT_GENERATION_BLOCK_BATCH_SIZE=6
# CONTENT_GENERATION_BLOCK_CONCURRENCY=2
# CONTENT_GENERATION_OPENAI_MAX_ATTEMPTS=3
# CONTENT_GENERATION_BATCH_MAX_OUTPUT_TOKENS=16384
# CONTENT_GENERATION_MERGED_MAX_OUTPUT_TOKENS=65536

# --- Motor de regeneração com prompt (/api/v1/regenerate/*) ---
# Independente da rotação acima (GEMINI_API_KEY) — usado especificamente
# pelos endpoints de regeneração/expansão com prompt do professor. Aceita
# ate 4 chaves Gemini adicionais via variaveis separadas OU uma lista unica
# separada por virgula em GEMINI_API_KEYS (soma-se as chaves de
# GEMINI_API_KEY acima, sem duplicar). OPENAI_API_KEY (já definida acima) é
# o último recurso dessa cascata (gpt-4o-mini, depois gpt-3.5-turbo).
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEYS=chave1,chave2,chave3,chave4
# OPENAI_CONTENT_GENERATION_FALLBACK_MODEL=gpt-4o-mini
# OPENAI_CONTENT_GENERATION_MAX_OUTPUT_TOKENS=16384
# CONTENT_GENERATION_GEMINI_COOLDOWN_MS=300000
# CONTENT_GENERATION_GEMINI_IMAGE_COOLDOWN_MS=3600000
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# CONTENT_GENERATION_OPENAI_IMAGE_COOLDOWN_MS=1800000
# OPENAI_SLIDE_IMAGE_QUALITY=medium
# PERSONALIZACAO_MAX_CONCURRENT_JOBS=2
# gpt-image-1 (slide inteiro como imagem unica) esta "Not supported" em
# alguns tiers da OpenAI — desligado por padrao (cai pro pipeline legado
# com cena via Gemini). Habilite so se a conta suportar o modelo.
# ENABLE_OPENAI_FULL_SLIDE_IMAGES=false
# Motor de apresentacao (BrainHexPDF, servico externo — ver
# docs/superpowers/specs/2026-08-15-brainhexpdf-integracao-design.md)
BRAINHEXPDF_API_URL=http://localhost:3002
BRAINHEXPDF_API_SECRET=
# BRAINHEXPDF_TIMEOUT_MS=120000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor (opcionais)
# PORT=3000
# JSON_LIMIT=50mb
# NODE_ENV=production
# SHUTDOWN_TIMEOUT_MS=30000
# API_ONLY=true              # pula setup de SPA (Vite/dist) — só endpoints /api/*
                             # ou use `npm run dev:api` (detecta automaticamente)
# Validação / SSRF / abuso
# ALLOW_PRIVATE_FONTE_URLS=true  # permite fontes apontando para localhost/RFC1918
                                # NUNCA em produção (default: false)
# MAX_FONTE_SIZE_MB=100          # tamanho máximo por fonte baixada (default 100MB)
# FONTE_FETCH_TIMEOUT_MS=30000   # timeout por download de fonte
# RATE_WINDOW_MS=60000           # janela do rate limiter (default 60s)
# RATE_MAX=30                    # max requests por IP por janela (default 30/min)

# Logging
# LOG_LEVEL=info             # debug | info | warn | error
# LOG_FORMAT=pretty          # pretty (dev) | json (prod) — default segue NODE_ENV

# MAX_JOB_DURATION_MS=900000  # timeout duro do job (15min default)
# HEARTBEAT_INTERVAL_MS=30000 # heartbeat atualiza updated_at a cada 30s (default)
# STALE_JOB_THRESHOLD_MS=150000 # jobs sem heartbeat há > isto = órfãos (default 5x heartbeat = 2.5min)

# Segurança (recomendado em produção)
# API_SHARED_SECRET=                 # header: x-api-secret ou Authorization: Bearer <secret>
# CORS_ORIGIN=https://trailup.app    # CSV, sem env libera tudo
