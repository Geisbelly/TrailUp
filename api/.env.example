APP_ENV=development
DATABASE_MIGRATIONS_ON_STARTUP=true
APP_DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trailup
ALEMBIC_DATABASE_URL=
LANGGRAPH_DB_URL=postgresql://postgres:postgres@localhost:5432/trailup
SUPABASE_URL=https://xrebtkmdewolzmpsdwgh.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=authenticated
# Gemini e gratuito e e o provedor principal (supervisor do LangGraph,
# gerar_cards_direto, generate_plano_personalizacao etc.) — OpenAI so entra
# em caminhos que fixam provider="openai" explicitamente.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL_SUPERVISOR=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o-mini
# gpt-5.4-mini tem tier de 10 RPM / 50 RPD — inviavel pro enriquecimento.
# gpt-4o-mini (500 RPM / 10.000 RPD) e usado so como reserva secundaria; o
# provedor principal e o Gemini (gratuito), ver GEMINI_API_KEY abaixo.
OPENAI_CONTENT_ENRICHMENT_MODEL=gpt-4o-mini
# Era 1: um topico com ~24 blocos precisava de ~24 chamadas de
# enriquecimento, e o free tier do Gemini tem cota de so 20 req/dia
# (gemini-3.6-flash) - um topico sozinho ja estourava a cota gratuita.
CONTENT_ENRICHMENT_BATCH_SIZE=6
CONTENT_ENRICHMENT_MAX_ATTEMPTS=3
OPENAI_CONTENT_ENRICHMENT_MAX_OUTPUT_TOKENS=8192
CONTENT_ENRICHMENT_QUOTA_COOLDOWN_SEC=300
# Trava de gasto estimado da OpenAI (best-effort, em memoria — NAO substitui
# um hard limit de billing configurado direto no dashboard da OpenAI).
OPENAI_SPEND_CAP_USD=1.0
PERSONALIZACAO_CONTENT_ENRICHMENT_CONCURRENCY=1
PERSONALIZACAO_CONTENT_ENRICHMENT_CACHE_MAX_ENTRIES=128
# Aceita 1 ou varias chaves separadas por virgula/ponto-e-virgula
# (GEMINI_API_KEY=chave1,chave2,chave3) — cada chave tem sua propria cota
# diaria gratuita, e o enriquecimento (content_enrichment.py) alterna
# automaticamente pra proxima disponivel quando uma esgota a cota.
GEMINI_API_KEY=
# gemini-1.5-pro/gemini-1.5-flash foram aposentados (401 UNAUTHENTICATED via
# chave de API simples) — gemini-3.6-flash e o modelo confirmado funcionando.
GEMINI_MODEL_SUPERVISOR=gemini-3.6-flash
GEMINI_MODEL_DEFAULT=gemini-3.6-flash
GEMINI_MATERIAIS_MODEL=gemini-3.6-flash
GEMINI_MODEL_MULTIMODAL_PRIMARY=gemini-3.6-flash
GEMINI_MODEL_MULTIMODAL_FALLBACK=gemini-2.5-flash-lite
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts
# Provedor PRINCIPAL do aprofundamento curricular (content_enrichment.py) —
# gratuito no tier atual. A OpenAI so entra como reserva se isso falhar.
CONTENT_ENRICHMENT_GEMINI_MODEL=gemini-3.6-flash
# Cota diaria e por (chave, modelo) — varios desses modelos tem teto maior
# (ou ilimitado) que o principal. Cada um e tentado em todas as chaves antes
# de passar pro proximo, so quando TODAS esgotam a cota do modelo anterior.
CONTENT_ENRICHMENT_GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash-lite
CONTENT_ENRICHMENT_GEMINI_QUOTA_COOLDOWN_SEC=300
PERSONALIZACAO_FORCE_ALL_MEDIA_FORMATS=true
PERSONALIZACAO_MAX_INLINE_SOURCE_BYTES=18000000
PERSONALIZACAO_SOURCE_PAGE_SIZE=100
PERSONALIZACAO_MAX_CONTEXT_SOURCES=400
PERSONALIZACAO_MEDIA_RENDER_CONCURRENCY=2
PERSONALIZACAO_MEDIA_RENDER_TIMEOUT_SEC=240
MEDIA_RENDER_TIMEOUT_SECONDS=1800
PERSONALIZACAO_MEDIA_JOB_TIMEOUT_SEC=1800
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=trailup-local
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change-me
BRAINHEX_API_URL=http://localhost:3000
# Precisa bater com API_SHARED_SECRET no microservice (api-brainhex); obrigatorio em producao.
BRAINHEX_API_SECRET=
# Tolera o cold start do Render e repete respostas 5xx temporarias.
BRAINHEX_HEALTH_TIMEOUT_SEC=90
BRAINHEX_HEALTH_MAX_ATTEMPTS=3
BRAINHEX_HEALTH_RETRY_DELAY_SEC=2
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhyZWJ0a21kZXdvbHptcHNkd2doIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU0MDIzMTQsImV4cCI6MjA5MDk3ODMxNH0.N31oDKmJ0rFoGTq983GWRrOqGo5EUCnsYrVTQNGH-Yk
