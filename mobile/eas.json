{
  "cli": { 
    "version": ">= 16.4.0", 
    "appVersionSource": "remote" 
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUILD_PROFILE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APITRAIUP_URL": "https://api.trailup.promora.dev.br",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APITRAIUP_URL": "https://api.trailup.promora.dev.br",
        "EXPO_PUBLIC_BUILD_PROFILE": "production"
      },
      "android": {
        "buildType": "apk"    
      },
      "ios": {
        "simulator": false   
      }
    },
    "productionAAB": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APITRAIUP_URL": "https://api.trailup.promora.dev.br",
        "EXPO_PUBLIC_BUILD_PROFILE": "productionAAB"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": { "production": {} }
}
