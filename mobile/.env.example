EXPO_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# API FastAPI do TrailUp
# iOS simulator / web local: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Dispositivo fisico: use o IP da maquina na rede, ex. http://192.168.0.10:8000
EXPO_PUBLIC_APITRAIUP_URL=http://10.0.2.2:8000

# Servico de apresentacoes (BrainHexPDF), endereco PUBLICO.
#
# Opcional: serve de rede de seguranca quando o deck foi gravado no banco com o
# nome interno do container (APP_URL mal configurado no lado do servidor). Com
# esta variavel, o app troca so o host da URL do deck e o material abre; sem ela,
# mostra o motivo em vez de tela branca.
#
# A correcao de verdade e o APP_URL do BrainHexPDF -- isto so recupera o material
# JA gravado errado.
# EXPO_PUBLIC_BRAINHEXPDF_URL=https://deck.seu-dominio.com
